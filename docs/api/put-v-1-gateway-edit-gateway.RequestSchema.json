{"title":"Body","body":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","description":"Account Name","example":"John Smith","maxLength":256},"user":{"type":"string","description":"SMTP authentication username","example":"smtp-user","nullable":true,"maxLength":1024,"x-convert":{"trim":true}},"pass":{"type":"string","description":"SMTP authentication password","example":"verysecret","nullable":true,"maxLength":1024},"host":{"type":"string","description":"Hostname to connect to","example":"smtp.gmail.com","x-format":{"hostname":true}},"port":{"type":"integer","description":"Service port number","example":465,"minimum":1,"maximum":65536},"secure":{"type":"boolean","description":"Should connection use TLS. Usually true for port 465","example":true},"requireTLS":{"type":"boolean","description":"Require STARTTLS when secure is false. Defaults to true: the connection fails if the server does not offer STARTTLS or the upgrade fails. Set to false only for a server on a trusted network that has no TLS at all","example":true}},"title":"UpdateGateway"}}}}}